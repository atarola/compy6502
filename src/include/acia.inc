ACIA_BASE           = $A000

ACIA_DATA           = ACIA_BASE + 0
ACIA_STATUS         = ACIA_BASE + 1
ACIA_COMMAND        = ACIA_BASE + 2
ACIA_CONTROL        = ACIA_BASE + 3

; 65C51 status bits

ACIA_STATUS_IRQ     = %10000000
ACIA_STATUS_DSR     = %01000000
ACIA_STATUS_DCD     = %00100000
ACIA_STATUS_TX_EMPTY= %00010000
ACIA_STATUS_RX_FULL = %00001000
ACIA_STATUS_OVERRUN = %00000100
ACIA_STATUS_FRAME   = %00000010
ACIA_STATUS_PARITY  = %00000001

; Common aliases

ACIA_TX_READY       = ACIA_STATUS_TX_EMPTY
ACIA_RX_READY       = ACIA_STATUS_RX_FULL